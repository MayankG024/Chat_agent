{
  "name": "ai-live-chat-agent",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/shared"
  ],
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --parallel",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev:backend": "npm --prefix apps/backend run dev",
    "build:frontend": "npm --prefix apps/frontend run build",
    "preview:frontend": "npm --prefix apps/frontend run preview",
    "build:backend": "tsc --project apps/backend/tsconfig.json",
    "build:shared": "tsc --project packages/shared/tsconfig.json",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,js,json,svelte,css,md}\"",
    "db:generate": "npm --prefix apps/backend run db:generate",
    "db:migrate": "npm --prefix apps/backend run db:migrate"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
